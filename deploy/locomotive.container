# Quadlet unit: systemd runs the Locomotive container from this file.
# Template: deploy/playbook.yml fills in the domain from deploy/inventory.yml
# and installs it to /etc/containers/systemd/locomotive.container.

[Unit]
Description=Locomotive web app
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/locomotive:latest
ContainerName=locomotive
# Only reachable from the server itself; Caddy is the public entry point.
PublishPort=127.0.0.1:8000:8000
Volume=locomotive-data:/data
Secret=locomotive_secret_key,target=django_secret_key
Environment=DJANGO_ALLOWED_HOSTS={{ domain }}
Environment=DJANGO_CSRF_TRUSTED_ORIGINS=https://{{ domain }}
Environment=DJANGO_HTTPS=true

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
